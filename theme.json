{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1280px"
		},
		"color": {
			"custom": true,
			"customDuotone": true,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"slug": "primary",
					"color": "#1a56db",
					"name": "Primary"
				},
				{
					"slug": "primary-dark",
					"color": "#1340a8",
					"name": "Primary Dark"
				},
				{
					"slug": "primary-light",
					"color": "#e8f0fe",
					"name": "Primary Light"
				},
				{
					"slug": "accent",
					"color": "#f59e0b",
					"name": "Accent"
				},
				{
					"slug": "success",
					"color": "#10b981",
					"name": "Success"
				},
				{
					"slug": "danger",
					"color": "#ef4444",
					"name": "Danger"
				},
				{
					"slug": "dark",
					"color": "#111827",
					"name": "Dark"
				},
				{
					"slug": "gray-700",
					"color": "#374151",
					"name": "Gray 700"
				},
				{
					"slug": "gray-500",
					"color": "#6b7280",
					"name": "Gray 500"
				},
				{
					"slug": "gray-300",
					"color": "#d1d5db",
					"name": "Gray 300"
				},
				{
					"slug": "gray-100",
					"color": "#f3f4f6",
					"name": "Gray 100"
				},
				{
					"slug": "light",
					"color": "#f9fafb",
					"name": "Light"
				},
				{
					"slug": "white",
					"color": "#ffffff",
					"name": "White"
				}
			],
			"gradients": [
				{
					"slug": "primary-to-accent",
					"gradient": "linear-gradient(135deg, #1a56db 0%, #f59e0b 100%)",
					"name": "Primary to Accent"
				},
				{
					"slug": "subtle-fade",
					"gradient": "linear-gradient(180deg, #ffffff 0%, #f9fafb 100%)",
					"name": "Subtle Fade"
				},
				{
					"slug": "dark-overlay",
					"gradient": "linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(17,24,39,0.8) 100%)",
					"name": "Dark Overlay"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "primary",
					"name": "Plus Jakarta Sans",
					"fontFamily": "'Plus Jakarta Sans', system-ui, -apple-system, sans-serif"
				},
				{
					"slug": "mono",
					"name": "JetBrains Mono",
					"fontFamily": "'JetBrains Mono', ui-monospace, monospace"
				},
				{
					"slug": "system",
					"name": "System Font",
					"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "normal",
					"size": "1rem",
					"name": "Normal"
				},
				{
					"slug": "medium",
					"size": "1.125rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.25rem",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "1.5rem",
					"name": "Extra Large"
				},
				{
					"slug": "xx-large",
					"size": "2.25rem",
					"name": "Huge"
				}
			],
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true
		},
		"spacing": {
			"blockGap": true,
			"customSpacingSize": true,
			"margin": true,
			"padding": true,
			"units": [ "px", "em", "rem", "%", "vh", "vw" ],
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{
					"slug": "20",
					"size": "0.5rem",
					"name": "Tiny"
				},
				{
					"slug": "30",
					"size": "1rem",
					"name": "Small"
				},
				{
					"slug": "40",
					"size": "1.5rem",
					"name": "Medium"
				},
				{
					"slug": "50",
					"size": "2rem",
					"name": "Large"
				},
				{
					"slug": "60",
					"size": "3rem",
					"name": "Extra Large"
				},
				{
					"slug": "70",
					"size": "5rem",
					"name": "Huge"
				}
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": true,
			"presets": [
				{
					"slug": "small",
					"shadow": "0 1px 2px 0 rgba(0,0,0,0.05)",
					"name": "Small"
				},
				{
					"slug": "medium",
					"shadow": "0 4px 6px -1px rgba(0,0,0,0.1), 0 2px 4px -2px rgba(0,0,0,0.1)",
					"name": "Medium"
				},
				{
					"slug": "large",
					"shadow": "0 10px 15px -3px rgba(0,0,0,0.1), 0 4px 6px -4px rgba(0,0,0,0.1)",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"shadow": "0 20px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1)",
					"name": "Extra Large"
				}
			]
		},
		"custom": {
			"listingcore-transition": "all 0.2s cubic-bezier(0.4, 0, 0.2, 1)",
			"listingcore-transition-slow": "all 0.35s cubic-bezier(0.4, 0, 0.2, 1)",
			"listingcore-container-width": "1280px",
			"listingcore-border-radius": "0.5rem",
			"listingcore-border-radius-lg": "1rem",
			"listingcore-border-radius-xl": "1.5rem"
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var(--listingcore-white, #ffffff)",
			"text": "var(--listingcore-dark, #111827)"
		},
		"typography": {
			"fontFamily": "var(--listingcore-font-primary, 'Plus Jakarta Sans', system-ui, sans-serif)",
			"fontSize": "var(--listingcore-text-base, 1rem)",
			"lineHeight": "var(--listingcore-line-height, 1.6)"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--40, 1.5rem)",
				"right": "var(--wp--preset--spacing--40, 1.5rem)"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--listingcore-primary, #1a56db)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.25"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "2.25rem"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "1.875rem"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "1.5rem"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "1.25rem"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "1.125rem"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "1rem",
					"textTransform": "uppercase",
					"letterSpacing": "0.05em"
				}
			},
			"button": {
				"border": {
					"radius": "0.5rem"
				},
				"color": {
					"background": "var(--listingcore-primary, #1a56db)",
					"text": "var(--listingcore-white, #ffffff)"
				},
				"typography": {
					"fontWeight": "600",
					"fontSize": "1rem"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--listingcore-primary-dark, #1340a8)"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": "0.5rem"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--listingcore-primary, #1a56db)",
						"style": "solid",
						"width": "4px"
					}
				},
				"spacing": {
					"padding": {
						"left": "1.5rem"
					}
				}
			},
			"core/code": {
				"typography": {
					"fontFamily": "var(--listingcore-font-mono, 'JetBrains Mono', monospace)",
					"fontSize": "0.875rem"
				},
				"color": {
					"background": "#f3f4f6",
					"text": "#111827"
				},
				"border": {
					"radius": "0.5rem"
				},
				"spacing": {
					"padding": {
						"top": "1rem",
						"bottom": "1rem",
						"left": "1rem",
						"right": "1rem"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "template-listings",
			"title": "Listings Archive",
			"postTypes": [ "page" ]
		},
		{
			"name": "template-submit",
			"title": "Submit Listing",
			"postTypes": [ "page" ]
		},
		{
			"name": "template-dashboard",
			"title": "User Dashboard",
			"postTypes": [ "page" ]
		},
		{
			"name": "template-wishlist",
			"title": "Wishlist",
			"postTypes": [ "page" ]
		}
	]
}